{
  "name": "cognitive-load-router",
  "displayName": "Cognitive Load Router",
  "description": "IDE telemetry plugin for the Cognitive Load Router",
  "publisher": "clr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Space-Paragon1/Cognitive-Inference-Engine.git",
    "directory": "plugins/vscode-extension"
  },
  "version": "0.3.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clr.connect",
        "title": "CLR: Connect to Engine"
      },
      {
        "command": "clr.disconnect",
        "title": "CLR: Disconnect"
      },
      {
        "command": "clr.toggleTelemetry",
        "title": "CLR: Toggle Telemetry"
      },
      {
        "command": "clr.openDashboard",
        "title": "CLR: Open Dashboard"
      }
    ],
    "configuration": {
      "title": "Cognitive Load Router",
      "properties": {
        "clr.engineUrl": {
          "type": "string",
          "default": "https://cognitive-inference-engine-production.up.railway.app",
          "description": "Address of the CLR engine. The default is the hosted engine; use http://127.0.0.1:8765 for one running on this computer. Run 'CLR: Connect to Engine' after changing it."
        },
        "clr.dashboardUrl": {
          "type": "string",
          "default": "https://pretty-grace-production-e75e9439.up.railway.app",
          "description": "Address of the CLR web app, opened by 'CLR: Open Dashboard'."
        },
        "clr.telemetryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Send IDE telemetry to the CLR engine"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --out clr-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
