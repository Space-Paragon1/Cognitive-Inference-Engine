{
  "manifest_version": 3,
  "name": "Cognitive Load Router — Browser Telemetry",
  "version": "0.3.1",
  "description": "Sends browser activity telemetry to your Cognitive Load Router engine.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "idle",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://cognitive-inference-engine-production.up.railway.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "clr-tokens.js",
        "clr-icons.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cognitive Load Router"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
